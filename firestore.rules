rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection collection
    match /test/{docId} {
      allow read, write: if request.auth != null;
    }

    // User profile: only the user themselves can read and write
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Two-player game rooms:
    // Only the 2 members of a room can read/write that room, plus joining validation
    match /rooms/{code} {
      // Read allowed if user is already a member, OR room is waiting to be joined
      allow get: if request.auth != null && (
        (resource.data.playerUids != null && request.auth.uid in resource.data.playerUids) ||
        (resource.data.status == 'waiting' && resource.data.playerUids.size() < 2)
      );

      // List not allowed broadly (no query scraping)
      allow list: if false;

      // Create: Host creates room with themselves as the single player
      allow create: if request.auth != null &&
        request.resource.data.hostUid == request.auth.uid &&
        request.auth.uid in request.resource.data.playerUids &&
        request.resource.data.playerUids.size() == 1;

      // Update: Either existing member making a game move/state update, or new player joining (max 2)
      allow update: if request.auth != null && (
        // Existing player in the room updating state
        (request.auth.uid in resource.data.playerUids) ||
        // Second player joining waiting room
        (resource.data.status == 'waiting' &&
         resource.data.playerUids.size() < 2 &&
         request.auth.uid in request.resource.data.playerUids &&
         request.resource.data.playerUids.size() == 2)
      );

      // Delete: Host or room members can remove room
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid in resource.data.playerUids
      );
    }
  }
}
